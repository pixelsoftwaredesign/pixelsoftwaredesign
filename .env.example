# Pixel Software Design - Environment Configuration
# Copy this file to .env and update the values

# PostgreSQL
DB_USER=pixelsoft
DB_PASSWORD=change_me_in_production

# JWT Secret (same for both apps)
JWT_SECRET=pixelsoftwaredesign-shared-secret-key-2026-unified-auth

# Internal API Key (same for both apps)
INTERNAL_API_KEY=pixelsoft-internal-api-key-2026

# Domain URLs (for CORS)
CRM_DOMAIN=https://crm.pixelsoftwaredesign.xyz
ERP_DOMAIN=https://erp.pixelsoftwaredesign.xyz
